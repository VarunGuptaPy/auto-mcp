# Copy this file to .env and fill in your values.
# docker compose reads .env automatically.

# Required: your DeepSeek API key (never committed to source control)
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-100ffb6d5e154901bebf48c6fa167f27

# GitHub OAuth (optional — enables "Connect GitHub" button for private repos)
# Create an OAuth App at https://github.com/settings/developers
# Set the Authorization callback URL to http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=Ov23lilOrOfBdhmqJHcQ
GITHUB_CLIENT_SECRET=2235a9ec4764d4edf29f45cd4e0b391077e0ce5b
# In production, set this to your public domain (must match the GitHub App callback URL)
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# Optional tuning
MAX_CONCURRENT_JOBS=2       # max parallel Chromium instances
JOB_TIMEOUT_SECONDS=600     # 10 minutes per job hard limit
